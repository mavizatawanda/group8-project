lization(\"DevOps\")\n81:                 .classification(\"First Class\")\n82:                 .awardDate(LocalDate.of(2024, 6, 1))\n83:                 .institutionId(1L)\n84:                 .build();\n85:     }\n86: \n87:     @Test\n88:     @DisplayName(\"Should successfully register qualification with hash generation\")\n89:     void testRegisterQualificationSuccess() {\n90:         when(qualificationRepository.existsByCertificateNumber(sampleRequest.getCertificateNumber())).thenReturn(false);\n91:         when(institutionRepository.findById(1L)).thenReturn(Optional.of(sampleInstitution));\n92:         when(cryptoHashService.generateFingerprint(anyString(), anyString(), anyString(), anyString(), anyString(), any(LocalDate.class)))\n93:                 .thenReturn(\"generated_hash_abc\");\n94:         when(qualificationRepository.save(any(Qualification.class))).thenReturn(sampleQualification);\n95: \n96:         QualificationResponse response = qualificationService.registerQualification(sampleRequest);\n97: \n98:         assertNotNull(response);\n99:         assertEquals(\"QVS-2024-ENG-01\", response.getCertificateNumber());\n100:         assertEquals(\"Jane Doe\", response.getStudentFullName());\n101:         verify(qualificationRepository).save(any(Qualification.class));\n102:     }\n103: \n104:     @Test\n105:     @DisplayName(\"Should throw BadRequestException if certificate number already registered\")\n106:     void testRegisterDuplicateCertificateThrowsException() {\n107:         when(qualificationRepository.existsByCertificateNumber(sampleRequest.getCertificateNumber())).thenReturn(true);\n108: \n109:         assertThrows(BadRequestException.class, () -> qualificationService.registerQualification(sampleRequest));\n110:         verify(qualificationRepository, never()).save(any());\n111:     }\n112: \n113:     @Test\n114:     @DisplayName(\"Should retrieve qualification by certificate number\")\n115:     void testGetByCertificateNumberSuccess() {\n116:    