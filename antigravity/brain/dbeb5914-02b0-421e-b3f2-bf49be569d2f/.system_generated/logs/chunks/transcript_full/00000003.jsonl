        </div>\n            </a>\n\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle navigation\">\n                <span></span><span></span><span></span>\n            </button>\n\n            <div class=\"nav-menu\" id=\"navMenu\">\n                <a href=\"#verifySection\" class=\"nav-link active\">Verify Credential</a>\n                <a href=\"#blockchainSection\" class=\"nav-link\">Blockchain Ledger</a>\n                <a href=\"#aiSection\" class=\"nav-link\">AI Fraud Shield</a>\n                <a href=\"#featuresSection\" class=\"nav-link\">DevOps Architecture</a>\n                <a href=\"/audit\" class=\"nav-link\">Audit Trail</a>\n                <a href=\"/swagger-ui.html\" target=\"_blank\" class=\"nav-link\">API Docs</a>\n                <div class=\"nav-auth\">\n                    <a href=\"/login\" class=\"btn-primary btn-sm\">Staff Login ➔</a>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero / Welcome Section -->\n    <header class=\"hero-section\">\n        <div class=\"hero-bg-glow\"></div>\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge\">\n                <span class=\"pulse-dot\"></span>\n                <span>Automated CI/CD Quality Gates & Cryptographic Consensus</span>\n            </div>\n            <h1 class=\"hero-title\">\n                Academic & Professional <br>\n                <span class=\"text-gradient\">Qualification Verification</span> System\n            </h1>\n            <p class=\"hero-description\">\n                Instant, tamper-evident credential verification powered by SHA-256 digital fingerprinting,\n                an immutable on-chain cryptographic ledger, and agentic AI anomaly heuristics.\n            </p>\n\n            <!-- Verification Search Card -->\n            <div class=\"search-box-wrapper\" id=\"verifySection\">\n                <div class=\"search-card\">\n                    <div class=\"search-card-header\">\n                        <label for=\"verificationInput\" class=\"search-label\">\n                            🔍 Instant Credential & Blockchain Lookup\n                        </label>\n                        <span class=\"search-hint\">Enter Certificate ID or SHA-256 Hash</span>\n                    </div>\n\n                    <div class=\"input-group\">\n                        <input type=\"text\" id=\"verificationInput\" class=\"input-control\" placeholder=\"e.g. QVS-2024-BSC-8891\" autofocus>\n                        <button class=\"btn-primary btn-search\" onclick=\"verifyCredential()\">\n                            <span>Verify Authenticity</span> ➔\n                        </button>\n                    </div>\n\n                    <!-- Quick Test Chips -->\n                    <div class=\"quick-test-bar\">\n                        <span class=\"quick-test-label\">Demo Records:</span>\n                        <button class=\"chip-btn chip-success\" onclick=\"verifyCredential('QVS-2024-BSC-8891')\">\n                            ✓ Sarah Jenkins (Active BSc)\n                        </button>\n                        <button class=\"chip-btn chip-success\" onclick=\"verifyCredential('QVS-2023-MSC-4412')\">\n                            ✓ David Miller (Active MSc)\n                        </button>\n                        <button class=\"chip-btn chip-danger\" onclick=\"verifyCredential('QVS-2022-DIP-1109')\">\n                            ⚠ Marcus Vance (Revoked)\n                        </button>\n                        <button class=\"chip-btn chip-neutral\" onclick=\"verifyCredential('FAKE-INVALID-999')\">\n                            ✕ Fake Certificate\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Loading Spinner -->\n            <div id=\"loadingIndicator\" class=\"loading-box\" style=\"display: none;\">\n                <div class=\"spinner\"></div>\n                <p>Querying institutional registry, verifying SHA-256 hash, and validating blockchain block consensus...</p>\n            </div>\n\n            <!-- Verification Result Card -->\n            <div id=\"resultCard\" class=\"result-card\" style=\"display: none;\">\n                <div class=\"result-header\">\n                    <div>\n                        <span class=\"result-eyebrow\">Official Verification Response</span>\n                        <h2 id=\"resultTitle\" class=\"result-title\">Verification Outcome</h2>\n                        <p id=\"statusMessage\" class=\"result-desc\"></p>\n                    </div>\n                    <span id=\"statusBadge\" class=\"status-badge status-badge-success\">GENUINE</span>\n                </div>\n\n                <div id=\"certDetails\" class=\"cert-details-body\">\n                    <!-- Credential Data Grid -->\n                    <div class=\"credential-grid\">\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Graduate Full Name</span>\n                            <span class=\"data-value\" id=\"resStudentName\">-</span>\n                        </div>\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Student ID / Registry Ref</span>\n                            <span class=\"data-value\" id=\"resStudentId\">-</span>\n                        </div>\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Award Title & Degree</span>\n                            <span class=\"data-value\" id=\"resAwardTitle\">-</span>\n                        </div>\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Major / Specialization</span>\n                            <span class=\"data-value\" id=\"resSpecialization\">-</span>\n                        </div>\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Grade / Honors</span>\n                            <span class=\"data-value\" id=\"resClassification\">-</span>\n                        </div>\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Awarding Institution</span>\n                            <span class=\"data-value\" id=\"resInstitution\">-</span>\n                        </div>\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Conferment Date</span>\n                            <span class=\"data-value\" id=\"resAwardDate\">-</span>\n                        </div>\n                        <div class=\"data-card\">\n                            <span class=\"data-label\">Certificate Serial Number</span>\n                            <span class=\"data-value font-mono\" id=\"resCertNumber\">-</span>\n                        </div>\n                    </div>\n\n                    <!-- Cryptographic Proof Box -->\n                    <div class=\"crypto-proof-box\">\n                        <div class=\"proof-header\">\n                            <span>🔒 Tamper-Evident SHA-256 Digital Fingerprint</span>\n                            <span class=\"verified-tag\">✓ Cryptographically Intact</span>\n                        </div>\n                        <div class=\"hash-code\" id=\"resFingerprint\">-</div>\n                    </div>\n\n                    <!-- AI Fraud Assessment Preview Banner -->\n                    <div class=\"ai-assessment-box\" id=\"resAiAssessmentBox\">\n                        <div class=\"ai-box-header\">\n                            <span class=\"ai-icon\">🤖</span>\n                            <div>\n                                <strong>Agentic AI Fraud Risk Assessment:</strong>\n                                <span id=\"resAiRiskBadge\" class=\"ai-badge ai-badge-low\">LOW RISK (100/100)</span>\n                            </div>\n                        </div>\n                        <p id=\"resAiExplanation\" class=\"ai-box-text\">All heuristic risk vectors verified: zero payload modification, active institutional accreditation, and authentic chronological issuance.</p>\n                    </div>\n\n                    <div class=\"result-footer\">\n                        <span>Audit Log ID: <strong id=\"resAuditId\">AUDIT-0</strong></span>\n                        <span>Consensus Node: <strong>QVS-VALIDATOR-01 (UK Cloud)</strong></span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Live Statistics Counter Grid -->\n    <section class=\"stats-section\">\n        <div class=\"container stats-grid\">\n            <div class=\"stat-card\">\n                <div class=\"stat-icon\">🎓</div>\n                <div class=\"stat-number\" id=\"statQualifications\">3</div>\n                <div class=\"stat-title\">Qualifications Registered</div>\n                <div class=\"stat-sub\">100% Notarized on Chain</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-icon\">⛓️</div>\n                <div class=\"stat-number\" id=\"statBlocks\">4</div>\n                <div class=\"stat-title\">Blockchain Blocks</div>\n                <div class=\"stat-sub\">SHA-256 Hash Chained</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-icon\">🛡️</div>\n                <div class=\"stat-number\" id=\"statVerifications\">100%</div>\n                <div class=\"stat-title\">Integrity Success Rate</div>\n                <div class=\"stat-sub\">Zero Forgery Tolerance</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-icon\">⚡</div>\n                <div class=\"stat-number\">99.9%</div>\n                <div class=\"stat-title\">DevOps CI/CD Uptime</div>\n                <div class=\"stat-sub\">Automated Quality Gates</div>\n            </div>\n        </div>\n    </section>\n\n    <!-- How It Works Section -->\n    <section class=\"how-it-works-section\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Zero-Trust Process</span>\n                <h2 class=\"section-title\">How Cryptographic Verification Works</h2>\n                <p class=\"section-subtitle\">A decentralized, automated verification flow from university registrar to employer verification.</p>\n            </div>\n\n            <div class=\"steps-grid\">\n                <div class=\"step-card\">\n                    <div class=\"step-badge\">Step 1</div>\n                    <div class=\"step-icon\">🏛️</div>\n                    <h3 class=\"step-title\">Institutional Issuance</h3>\n                    <p class=\"step-desc\">The accredited registrar registers the graduate's award. A deterministic SHA-256 cryptographic signature is computed over student identity and academic parameters.</p>\n                </div>\n                <div class=\"step-card\">\n                    <div class=\"step-badge\">Step 2</div>\n                    <div class=\"step-icon\">⛓️</div>\n                    <h3 class=\"step-title\">Blockchain Mining</h3>\n                    <p class=\"step-desc\">The qualification fingerprint is mined into an immutable block containing the previous block hash and proof-of-integrity nonce, preventing any future record alterations.</p>\n                </div>\n                <div class=\"step-card\">\n                    <div class=\"step-badge\">Step 3</div>\n                    <div class=\"step-icon\">🔍</div>\n                    <h3 class=\"step-title\">Instant Verification</h3>\n                    <p class=\"step-desc\">Employers and institutions verify the certificate serial number. The system performs real-time hash matching, blockchain validation, and AI fraud risk scoring.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Blockchain Explorer Section (Bonus Feature 1) -->\n    <section class=\"blockchain-section\" id=\"blockchainSection\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Bonus Feature: Distributed Ledger</span>\n                <h2 class=\"section-title\">Live Blockchain Credential Ledger</h2>\n                <p class=\"section-subtitle\">Real-time immutable cryptographic blocks anchoring qualification certificates.</p>\n            </div>\n\n            <div class=\"blockchain-card\">\n                <div class=\"blockchain-card-header\">\n                    <div>\n                        <h3 style=\"margin: 0; font-size: 1.15rem; color: #0f172a;\">⛓️ Cryptographic Block Stream</h3>\n                        <span style=\"font-size: 0.85rem; color: #64748b;\">Consensus: Proof-of-Integrity (PoI) • Hash Algorithm: SHA-256</span>\n                    </div>\n                    <button class=\"btn-outline btn-sm\" onclick=\"validateBlockchain()\">\n                        🔍 Validate Full Chain Integrity\n                    </button>\n                </div>\n\n                <div class=\"table-responsive\">\n                    <table class=\"blockchain-table\">\n                        <thead>\n                            <tr>\n                                <th>Block #</th>\n                                <th>Timestamp</th>\n                                <th>Certificate No.</th>\n                                <th>Payload Hash</th>\n                                <th>Previous Block Hash</th>\n                                <th>Block Hash</th>\n                                <th>Action</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"blockchainTableBody\">\n                            <tr><td colspan=\"7\" style=\"text-align: center; color: #64748b;\">Loading blockchain blocks...</td></tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Agentic AI & Advanced Features (Bonus Features 2 & 3) -->\n    <section class=\"features-section\" id=\"featuresSection\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">DevOps & Enterprise Security</span>\n                <h2 class=\"section-title\">DevOps Architecture & Bonus Modules</h2>\n                <p class=\"section-subtitle\">Engineered to meet enterprise software quality, CI/CD, and multi-cloud deployment benchmarks.</p>\n            </div>\n\n            <div class=\"features-grid\">\n                <div class=\"feature-card\">\n                    <div class=\"feature-icon\">🤖</div>\n                    <h3>Agentic AI Fraud Detection</h3>\n                    <p>Heuristic anomaly engine analyzing date timelines, signature patterns, and serial formatting to catch forged degrees before acceptance.</p>\n                    <span class=\"feature-pill\">AI Anomaly Scoring</span>\n                </div>\n                <div class=\"feature-card\">\n                    <div class=\"feature-icon\">⛓️</div>\n                    <h3>Blockchain Ledger</h3>\n                    <p>Cryptographic hash chaining with Genesis block foundation and Proof-of-Integrity consensus ensuring zero retroactive tampering.</p>\n                    <span class=\"feature-pill\">SHA-256 Chaining</span>\n                </div>\n                <div class=\"feature-card\">\n                    <div class=\"feature-icon\">☁️</div>\n                    <h3>Infrastructure-as-Code</h3>\n                    <p>Production Terraform modules (VPC, ECS Fargate, RDS) and Kubernetes manifests for automated multi-cloud provisioning.</p>\n                    <span class=\"feature-pill\">Terraform & K8s</span>\n                </div>\n                <div class=\"feature-card\">\n                    <div class=\"feature-icon\">📊</div>\n                    <h3>Real-Time Telemetry</h3>\n                    <p>Live Actuator metrics, JVM memory telemetry, and verification velocity monitoring dashboards.</p>\n                    <span class=\"feature-pill\">Prometheus & Actuator</span>\n                </div>\n                <div class=\"feature-card\">\n                    <div class=\"feature-icon\">🔒</div>\n                    <h3>Advanced Security & RBAC</h3>\n                    <p>Stateless JWT authentication, BCrypt password hashing, and role-based permissions (Admin, Institution, Verifier).</p>\n                    <span class=\"feature-pill\">Zero-Trust JWT</span>\n                </div>\n                <div class=\"feature-card\">\n                    <div class=\"feature-icon\">🚀</div>\n                    <h3>DevOps CI/CD Pipelines</h3>\n                    <p>Automated GitHub Actions workflow running Checkstyle static analysis, JaCoCo >80% coverage quality gates, and Docker multi-stage builds.</p>\n                    <span class=\"feature-pill\">GitHub Actions</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Floating Agentic AI Verification Assistant Widget -->\n    <div class=\"ai-widget-container\" id=\"aiSection\">\n        <button class=\"ai-floating-btn\" onclick=\"toggleAiChat()\" id=\"aiToggleBtn\" title=\"Ask QVS AI Assistant\">\n            <span class=\"ai-btn-icon\">🤖</span>\n            <span class=\"ai-btn-text\">AI Verification Assistant</span>\n            <span class=\"ai-btn-pulse\"></span>\n        </button>\n\n        <div class=\"ai-chat-window\" id=\"aiChatWindow\" style=\"display: none;\">\n            <div class=\"ai-chat-header\">\n                <div class=\"ai-header-info\">\n                    <span class=\"ai-avatar\">🤖</span>\n                    <div>\n                        <strong>QVS Agentic AI Assistant</strong>\n                        <span class=\"ai-online-status\">● Live Heuristic Agent</span>\n                    </div>\n                </div>\n                <button class=\"ai-close-btn\" onclick=\"toggleAiChat()\">✕</button>\n            </div>\n\n            <div class=\"ai-chat-messages\" id=\"aiChatMessages\">\n                <div class=\"ai-message ai-bot\">\n                    <p>Hello! I am your <strong>QVS Agentic AI Assistant</strong>. Ask me to:</p>\n                    <ul>\n                        <li>• Check specific certificates (e.g. <em>\"Check Sarah Jenkins\"</em>)</li>\n                        <li>• Explain how the <strong>Blockchain Ledger</strong> works</li>\n                        <li>• Analyze <strong>AI Fraud Risk</strong> and anomaly rules</li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"ai-quick-prompts\">\n                <button onclick=\"sendAiPrompt('Check Sarah Jenkins credential')\">Check Sarah</button>\n                <button onclick=\"sendAiPrompt('Why is Marcus Vance revoked?')\">Check Marcus</button>\n                <button onclick=\"sendAiPrompt('How does the blockchain protect credentials?')\">Explain Blockchain</button>\n            </div>\n\n            <div class=\"ai-chat-input-row\">\n                <input type=\"text\" id=\"aiChatInput\" placeholder=\"Ask anything about credential verification...\" onkeydown=\"if(event.key==='Enter') sendAiMessage()\">\n                <button class=\"btn-primary btn-sm\" onclick=\"sendAiMessage()\">Send</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Modern Footer -->\n    <footer class=\"footer\">\n        <div class=\"container footer-content\">\n            <div class=\"footer-brand\">\n                <div class=\"brand-logo\">🎓</div>\n                <div>\n                    <h4 style=\"margin: 0; font-size: 1.1rem; color: #fff;\">DevOps Qualification Verification System</h4>\n                    <p style=\"margin: 0.25rem 0 0; font-size: 0.85rem; color: #94a3b8;\">High-Integrity Academic & Professional Credential Infrastructure</p>\n                </div>\n            </div>\n            <div class=\"footer-links\">\n                <a href=\"/swagger-ui.html\" target=\"_blank\">Swagger OpenAPI</a>\n                <a href=\"/actuator/health\" target=\"_blank\">Health Status</a>\n                <a href=\"/audit\">Audit Trail</a>\n                <a href=\"/dashboard\">Institution Dashboard</a>\n                <a href=\"/login\">Officer Login</a>\n            </div>\n        </div>\n        <div class=\"footer-bottom\">\n            <div class=\"container\" style=\"display: flex; justify-content: space-between; font-size: 0.8rem; color: #64748b;\">\n                <span>&copy; 2026 DevOps QVS. Automated CI/CD • JaCoCo &gt;80% Gate • Docker Ready.</span>\n                <span>Version 2.0.0 (Enterprise Release)</span>\n            </div>\n        </div>\n    </footer>\n\n    <script src=\"/js/app.js\"></script>\n</body>\n</html>\n","Description":"Create modern responsive Welcome Landing page in index.html","Overwrite":true,"TargetFile":"C:\\Users\\Madziva\\.gemini\\antigravity\\scratch\\qualification-verification-system\\src\\main\\resources\\templates\\index.html","toolAction":"Updating index.html","toolSummary":"Write modern index.html"}}]}
