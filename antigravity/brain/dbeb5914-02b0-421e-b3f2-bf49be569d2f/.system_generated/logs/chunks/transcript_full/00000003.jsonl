dicator');\n40: \n41:     if (loadingSpinner) loadingSpinner.style.display = 'block';\n42:     if (resultCard) resultCard.style.display = 'none';\n43: \n44:     try {\n45:         const response = await fetch('/api/v1/verify', {\n46:             method: 'POST',\n47:             headers: {\n48:                 'Content-Type': 'application/json'\n49:             },\n50:             body: JSON.stringify({\n51:                 query: query,\n52:                 verifierName: 'Web Portal Visitor',\n53:                 verifierOrganization: 'External Inquirer'\n54:             })\n55:         });\n56: \n57:         const data = await response.json();\n58:         displayVerificationResult(data);\n59:     } catch (error) {\n60:         console.error('Verification error:', error);\n61:         alert('An error occurred during verification. Please check if the server is running.');\n62:     } finally {\n63:         if (loadingSpinner) loadingSpinner.style.display = 'none';\n64:     }\n65: }\n66: \n67: function displayVerificationResult(data) {\n68:     const resultCard = document.getElementById('resultCard');\n69:     if (!resultCard) return;\n70: \n71:     // Reset status classes\n72:     resultCard.className = 'result-card status-' + data.verificationStatus;\n73:     resultCard.style.display = 'block';\n74: \n75:     const statusBadge = document.getElementById('statusBadge');\n76:     const statusMessage = document.getElementById('statusMessage');\n77:     const certDetails = document.getElementById('certDetails');\n78: \n79:     let badgeClass = 'not-found';\n80:     let badgeText = data.verificationStatus.replace(/_/g, ' ');\n81: \n82:     if (data.verificationStatus === 'GENUINE_AND_VALID') {\n83:         badgeClass = 'genuine';\n84:         badgeText = '✓ GENUINE & VALID';\n85:     } else if (data.verificationStatus === 'REVOKED_CREDENTIAL') {\n86:         badgeClass = 'revoked';\n87:         badgeText = '⚠ REVOKED CREDENTIAL';\n88:     } else if (data.verificationStatus === 'SUSPICIOUS_OR_ALTERED') {\n89:         badgeClass = 'altered';\n90:         badgeText = '⛔ TAMPERED / INVALID';\n91:     } else {\n92:         badgeClass = 'not-found';\n93:         badgeText = '✕ RECORD NOT FOUND';\n94:     }\n95: \n96:     statusBadge.className = 'status-badge ' + badgeClass;\n97:     statusBadge.innerText = badgeText;\n98:     statusMessage.innerText = data.message;\n99: \n100:     if (data.certificateNumber) {\n101:         certDetails.style.display = 'block';\n102:         document.getElementById('resStudentName').innerText = data.studentFullName || 'N/A';\n103:         document.getElementById('resStudentId').innerText = data.studentIdNumber || 'N/A';\n104:         document.getElementById('resAwardTitle').innerText = data.awardTitle || 'N/A';\n105:         document.getElementById('resSpecialization').innerText = data.majorSpecialization || 'N/A';\n106:         document.getElementById('resClassification').innerText = data.classification || 'N/A';\n107:         document.getElementById('resInstitution').innerText = data.institutionName || 'N/A';\n108:         document.getElementById('resAwardDate').innerText = data.awardDate || 'N/A';\n109:         document.getElementById('resCertNumber').innerText = data.certificateNumber || 'N/A';\n110:         document.getElementById('resFingerprint').innerText = data.digitalFingerprint || 'N/A';\n111:         document.getElementById('resAuditId').innerText = 'AUDIT-' + (data.auditLogId || 'N/A');\n112:     } else {\n113:         certDetails.style.display = 'none';\n114:     }\n115: \n116:     resultCard.scrollIntoView({ behavior: 'smooth' });\n117: }\n118: \n119: // 2. Authentication Handling\n120: async function handleLogin(event) {\n121:     event.preventDefault();\n122:     const username = document.getElementById('username').value.trim();\n123:     const password = document.getElementById('password').value.trim();\n124:     const errorMsg = document.getElementById('loginError');\n125: \n126:     try