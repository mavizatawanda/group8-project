{"step_index":236,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-05T19:38:19Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Enterprise Management & DevOps Telemetry Dashboard | QVS</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"/css/style.css\">\n</head>\n<body>\n\n    <!-- Main Navigation -->\n    <nav class=\"navbar\">\n        <div class=\"nav-container\">\n            <a href=\"/\" class=\"nav-brand\">\n                <div class=\"brand-logo\">🎓</div>\n                <div class=\"brand-text\">\n                    <span class=\"brand-title\">DevOps QVS</span>\n                    <span class=\"brand-subtitle\">Institution Portal</span>\n                </div>\n            </a>\n\n            <div class=\"nav-menu\">\n                <a href=\"/\" class=\"nav-link\">Verify</a>\n                <a href=\"/dashboard\" class=\"nav-link active\">Dashboard</a>\n                <a href=\"/audit\" class=\"nav-link\">Audit Trail</a>\n                <a href=\"/swagger-ui.html\" target=\"_blank\" class=\"nav-link\">API Docs</a>\n                <div id=\"navAuthStatus\" class=\"nav-auth\">\n                    <a href=\"/login\" class=\"btn-primary btn-sm\">Login</a>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <main class=\"container dashboard-main\">\n        <!-- Dashboard Header -->\n        <div class=\"dash-header\">\n            <div>\n                <h1 class=\"dash-title\">Institution Management & Telemetry Center</h1>\n                <p class=\"dash-subtitle\">Manage qualifications, inspect blockchain notarization blocks, run AI fraud scans, and view real-time metrics.</p>\n            </div>\n            <button class=\"btn-primary\" onclick=\"showTab('qualificationsTab'); document.getElementById('registerSection').scrollIntoView({behavior: 'smooth'})\">\n                + Issue New Qualification\n            </button>\n        </div>\n\n        <!-- Dashboard Navigation Tabs -->\n        <div class=\"dash-tabs\">\n            <button class=\"dash-tab-btn active\" onclick=\"switchTab('qualificationsTab', this)\">\n                📋 Qualifications Registry\n            </button>\n            <button class=\"dash-tab-btn\" onclick=\"switchTab('blockchainTab', this)\">\n                ⛓️ Blockchain Ledger Explorer\n            </button>\n            <button class=\"dash-tab-btn\" onclick=\"switchTab('aiTab', this)\">\n                🤖 AI Fraud Shield & Anomaly Scanner\n            </button>\n            <button class=\"dash-tab-btn\" onclick=\"switchTab('telemetryTab', this)\">\n                📊 Live Real-Time Telemetry\n            </button>\n        </div>\n\n        <!-- TAB 1: Qualifications Registry -->\n        <div id=\"qualificationsTab\" class=\"tab-pane active\">\n            <div class=\"dash-card\">\n                <div class=\"dash-card-header\">\n                    <h3 style=\"margin: 0; font-size: 1.15rem; color: #0f172a;\">Accredited Qualification Records</h3>\n                    <span class=\"badge badge-success\">Live Registry</span>\n                </div>\n                <div class=\"table-responsive\">\n                    <table class=\"data-table\">\n                        <thead>\n                            <tr>\n                                <th>Certificate No.</th>\n                                <th>Student & ID</th>\n                                <th>Degree & Specialization</th>\n                                <th>Classification</th>\n                                <th>Institution</th>\n                                <th>Status</th>\n                                <th>Actions</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"qualificationsTableBody\">\n                            <tr><td colspan=\"7\" style=\"text-align: center; color: #64748b;\">Loading registered qualifications...</td></tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n\n            <!-- Issue New Qualification Form -->\n            <div id=\"registerSection\" class=\"dash-card\" style=\"margin-top: 2rem;\">\n                <div class=\"dash-card-header\">\n                    <div>\n                        <h3 style=\"margin: 0; font-size: 1.15rem; color: #0f172a;\">Issue New Academic Credential</h3>\n                        <p style=\"margin: 0.25rem 0 0; color: #64748b; font-size: 0.85rem;\">Automatically computes SHA-256 digital fingerprint and mines a new notarization block on the blockchain ledger.</p>\n                    </div>\n                </div>\n\n                <form id=\"qualificationForm\" onsubmit=\"handleRegisterQualification(event)\">\n                    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;\">\n                        <div>\n                            <label class=\"form-label\">Certificate Serial Number *</label>\n                            <input type=\"text\" id=\"certNumber\" class=\"input-control\" placeholder=\"e.g. QVS-2024-BENG-1092\" required>\n                        </div>\n                        <div>\n                            <label class=\"form-label\">Student Full Name *</label>\n                            <input type=\"text\" id=\"studentName\" class=\"input-control\" placeholder=\"e.g. Alexander Clark\" required>\n                        </div>\n                    </div>\n\n                    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;\">\n                        <div>\n                            <label class=\"form-label\">Student ID / National ID *</label>\n                            <input type=\"text\" id=\"studentId\" class=\"input-control\" placeholder=\"e.g. STU-119283\" required>\n                        </div>\n                        <div>\n                            <label class=\"form-label\">Award Title *</label>\n                            <input type=\"text\" id=\"awardTitle\" class=\"input-control\" placeholder=\"e.g. Bachelor of Engineering\" required>\n                        </div>\n                    </div>\n\n                    <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;\">\n                        <div>\n                            <label class=\"form-label\">Major / Specialization *</label>\n                            <input type=\"text\" id=\"majorSpec\" class=\"input-control\" placeholder=\"e.g. Cloud Computing\" required>\n                        </div>\n                        <div>\n                            <label class=\"form-label\">Classification / Grade *</label>\n                            <input type=\"text\" id=\"classification\" class=\"input-control\" placeholder=\"e.g. First Class Honours\" required>\n                        </div>\n                        <div>\n                            <label class=\"form-label\">Award Date *</label>\n                            <input type=\"date\" id=\"awardDate\" class=\"input-control\" required>\n                        </div>\n                    </div>\n\n                    <button type=\"submit\" class=\"btn-primary\" style=\"width: 100%;\">\n                        🔒 Sign, Notarize on Blockchain & Register Credential\n                    </button>\n                </form>\n            </div>\n        </div>\n\n        <!-- TAB 2: Blockchain Block Explorer -->\n        <div id=\"blockchainTab\" class=\"tab-pane\" style=\"display: none;\">\n            <div class=\"dash-card\">\n                <div class=\"dash-card-header\">\n                    <div>\n                        <h3 style=\"margin: 0; font-size: 1.15rem; color: #0f172a;\">⛓️ Immutable Blockchain Block Explorer</h3>\n                        <p style=\"margin: 0.25rem 0 0; color: #64748b; font-size: 0.85rem;\">Cryptographic ledger anchoring every qualification creation and revocation event with SHA-256 hash chaining.</p>\n                    </div>\n                    <button class=\"btn-outline btn-sm\" onclick=\"validateBlockchain()\">\n                        🔍 Verify Blockchain Consensus\n                    </button>\n                </div>\n\n                <div class=\"table-responsive\">\n                    <table class=\"blockchain-table\">\n                        <thead>\n                            <tr>\n                                <th>Block #</th>\n                                <th>Timestamp</th>\n                                <th>Certificate No.</th>\n                                <th>Payload Hash</th>\n                                <th>Previous Block Hash</th>\n                                <th>Block Hash</th>\n                                <th>Action</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"dashBlockchainTableBody\">\n                            <tr><td colspan=\"7\" style=\"text-align: center; color: #64748b;\">Loading blockchain blocks...</td></tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 3: AI Fraud Shield & Anomaly Scanner -->\n        <div id=\"aiTab\" class=\"tab-pane\" style=\"display: none;\">\n            <div class=\"dash-card\">\n                <div class=\"dash-card-header\">\n                    <div>\n                        <h3 style=\"margin: 0; font-size: 1.15rem; color: #0f172a;\">🤖 Agentic AI Fraud & Anomaly Scanner</h3>\n                        <p style=\"margin: 0.25rem 0 0; color: #64748b; font-size: 0.85rem;\">Run automated multi-vector heuristic analysis on any certificate to calculate fraud probability and detect forged records.</p>\n                    </div>\n                </div>\n\n                <div style=\"display: flex; gap: 1rem; margin-bottom: 1.5rem;\">\n                    <input type=\"text\" id=\"aiScanInput\" class=\"input-control\" placeholder=\"Enter Certificate Serial Number (e.g. QVS-2024-BSC-8891)\">\n                    <button class=\"btn-primary\" onclick=\"runAiScan()\">Run AI Fraud Scan</button>\n                </div>\n\n                <div id=\"aiScanResult\" style=\"display: none;\" class=\"ai-scan-output-card\">\n                    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;\">\n                        <div>\n                            <h4 style=\"margin: 0; font-size: 1.2rem; color: #0f172a;\">AI Evaluation Summary</h4>\n                            <span id=\"aiScanCert\" style=\"font-size: 0.85rem; color: #64748b; font-family: monospace;\">-</span>\n                        </div>\n                        <span id=\"aiScanScoreBadge\" class=\"ai-badge ai-badge-low\">SCORE: 100/100 (LOW RISK)</span>\n                    </div>\n\n                    <div style=\"margin-bottom: 1rem;\">\n                        <label style=\"font-weight: 600; font-size: 0.85rem; color: #475569;\">Recommendation:</label>\n                        <p id=\"aiScanRecommendation\" style=\"font-weight: 700; color: #0f172a; margin: 0.2rem 0;\"></p>\n                    </div>\n\n                    <div style=\"margin-bottom: 1rem;\">\n                        <label style=\"font-weight: 600; font-size: 0.85rem; color: #475569;\">Agent Explanation:</label>\n                        <p id=\"aiScanExplanation\" style=\"color: #334155; font-size: 0.95rem; margin: 0.2rem 0; line-height: 1.5;\"></p>\n                    </div>\n\n                    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;\">\n                        <div class=\"ai-checks-box\">\n                            <h5 style=\"color: #16a34a; margin: 0 0 0.5rem;\">✓ Passed Heuristic Checks</h5>\n                            <ul id=\"aiPassedList\" style=\"margin: 0; padding-left: 1.2rem; font-size: 0.85rem; color: #1e293b;\"></ul>\n                        </div>\n                        <div class=\"ai-checks-box\">\n                            <h5 style=\"color: #dc2626; margin: 0 0 0.5rem;\">⚠️ Triggered Anomaly Flags</h5>\n                            <ul id=\"aiAnomalyList\" style=\"margin: 0; padding-left: 1.2rem; font-size: 0.85rem; color: #1e293b;\"></ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- TAB 4: Live Real-Time Telemetry & Monitoring -->\n        <div id=\"telemetryTab\" class=\"tab-pane\" style=\"display: none;\">\n            <div class=\"stats-grid\" style=\"margin-bottom: 2rem;\">\n                <div class=\"stat-card\">\n                    <div class=\"stat-icon\">💾</div>\n                    <div class=\"stat-number\" id=\"metricRam\">0 MB</div>\n                    <div class=\"stat-title\">JVM Heap Memory Used</div>\n                    <div class=\"stat-sub\" id=\"metricRamTotal\">Total Allocated: 0 MB</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-icon\">⚡</div>\n                    <div class=\"stat-number\" id=\"metricUptime\">0s</div>\n                    <div class=\"stat-title\">System Runtime Uptime</div>\n                    <div class=\"stat-sub\">Zero Downtime Node</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-icon\">📊</div>\n                    <div class=\"stat-number\" id=\"metricVerifCount\">0</div>\n                    <div class=\"stat-title\">Total Verifications Processed</div>\n                    <div class=\"stat-sub\" id=\"metricSuccessRate\">Success Rate: 100%</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-icon\">⛓️</div>\n                    <div class=\"stat-number\" id=\"metricChainHeight\">0</div>\n                    <div class=\"stat-title\">Blockchain Ledger Height</div>\n                    <div class=\"stat-sub\" id=\"metricChainStatus\">Consensus: Valid</div>\n                </div>\n            </div>\n\n            <div class=\"dash-card\">\n                <div class=\"dash-card-header\">\n                    <h3 style=\"margin: 0; font-size: 1.15rem; color: #0f172a;\">Live Health Status & Telemetry Endpoints</h3>\n                    <button class=\"btn-outline btn-sm\" onclick=\"fetchTelemetry()\">🔄 Refresh Telemetry</button>\n                </div>\n                <div style=\"font-size: 0.9rem; color: #475569; line-height: 1.6;\">\n                    <p>• <strong>Spring Boot Actuator Health:</strong> <a href=\"/actuator/health\" target=\"_blank\" style=\"color: #2563eb; font-weight: 600;\">/actuator/health</a></p>\n                    <p>• <strong>OpenAPI Swagger Explorer:</strong> <a href=\"/swagger-ui.html\" target=\"_blank\" style=\"color: #2563eb; font-weight: 600;\">/swagger-ui.html</a></p>\n                    <p>• <strong>Real-Time JSON Telemetry Stream:</strong> <a href=\"/api/metrics/realtime\" target=\"_blank\" style=\"color: #2563eb; font-weight: 600;\">/api/metrics/realtime</a></p>\n                    <p>• <strong>Blockchain Consensus Endpoint:</strong> <a href=\"/api/blockchain/validate\" target=\"_blank\" style=\"color: #2563eb; font-weight: 600;\">/api/blockchain/validate</a></p>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <div class=\"container footer-bottom\" style=\"text-align: center; color: #64748b; font-size: 0.85rem;\">\n            DevOps Qualification Verification System &copy; 2026. High-Integrity Credential Infrastructure.\n        </div>\n    </footer>\n\n    <script src=\"/js/app.js\"></script>\n    <script>\n        function switchTab(tabId, btn) {\n            document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none');\n            document.querySelectorAll('.dash-tab-btn').forEach(b => b.classList.remove('active'));\n            document.getElementById(tabId).style.display = 'block';\n            if (btn) btn.classList.add('active');\n\n            if (tabId === 'blockchainTab') loadDashboardBlockchain();\n            if (tabId === 'telemetryTab') fetchTelemetry();\n        }\n\n        document.addEventListener('DOMContentLoaded', () => {\n            loadQualifications();\n            fetchTelemetry();\n        });\n    </script>\n</body>\n</html>\n","Description":"Update dashboard.html with Blockchain, AI, and Telemetry tabs","Overwrite":true,"TargetFile":"C:\\Users\\Madziva\\.gemini\\antigravity\\scratch\\qualification-verification-system\\src\\main\\resources\\templates\\dashboard.html","toolAction":"Updating dashboard.html","toolSummary":"Write upgraded dashboard.html"}}]}
