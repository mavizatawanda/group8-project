e}<br><small style=\"color: #64748b;\">${q.studentIdNumber}</small></td>\n175:                 <td>${q.awardTitle}<br><small style=\"color: #64748b;\">${q.majorSpecialization}</small></td>\n176:                 <td>${q.classification}</td>\n177:                 <td>${q.institutionName}</td>\n178:                 <td><span style=\"${statusClass}\">${q.status}</span></td>\n179:                 <td>\n180:                     <button class=\"chip-btn\" onclick=\"verifyFromDashboard('${q.certificateNumber}')\">Verify</button>\n181:                     ${q.status === 'ACTIVE' ? `<button class=\"chip-btn revoked\" onclick=\"revokeCert(${q.id})\">Revoke</button>` : ''}\n182:                 </td>\n183:             `;\n184:             tableBody.appendChild(row);\n185:         });\n186:     } catch (e) {\n187:         console.error('Error loading qualifications:', e);\n188:     }\n189: }\n190: \n191: function verifyFromDashboard(certNumber) {\n192:     window.location.href = '/?cert=' + encodeURIComponent(certNumber);\n193: }\n194: \n195: async function revokeCert(id) {\n196:     const reason = prompt('Please enter reason for revocation:');\n197:     if (!reason) return;\n198: \n199:     const token = getAuthToken();\n200:     if (!token) {\n201:         alert('You must be logged in as an Administrator to revoke qualifications.');\n202:         window.location.href = '/login';\n203:         return;\n204:     }\n205: \n206:     try {\n207:         const response = await fetch(`/api/v1/qualifications/${id}/revoke?reason=${encodeURIComponent(reason)}`, {\n208:             method: 'PUT',\n209:             headers: {\n210:                 'Authorization': 'Bearer ' + token\n211:             }\n212:         });\n213: \n214:         if (response.ok) {\n215:             alert('Qualification successfully revoked.');\n216:             loadQualifications();\n217:         } else {\n218:             alert('Failed to revoke qualification. Ensure you have ROLE_ADMIN privileges.');\n219:         }\n220:     } catch (e) {\n221:         console.error('Revoke error:', e);\n222:     }\n223: }\n224: \n225: // 4. Register New Qualification\n226: async function handleRegisterQualification(event) {\n227:     event.preventDefault();\n228:     const token = getAuthToken();\n229:     if (!token) {\n230:         alert('Please login to register qualifications.');\n231:         window.location.href = '/login';\n232:         return;\n233:     }\n234: \n235:     const payload = {\n236:         certificateNumber: document.getElementById('certNumber').value.trim(),\n237:         studentFullName: document.getElementById('studentName').value.trim(),\n238:         studentIdNumber: document.getElementById('studentId').value.trim(),\n239:         awardTitle: document.getElementById('awardTitle').value.trim(),\n240:         majorSpecialization: document.getElementById('majorSpec').value.trim(),\n241:         classification: document.getElementById('classification').value.trim(),\n242:         awardDate: document.getElementById('awardDate').value,\n243:         institutionId: 1 // Default institution\n244:     };\n245: \n246:     try {\n247:         const response = await fetch('/api/v1/qualifications', {\n248:             method: 'POST',\n249:             headers: {\n250:                 'Content-Type': 'application/json',\n251:                 'Authorization': 'Bearer ' + token\n252:             },\n253:             body: JSON.stringify(payload)\n254:         });\n255: \n256:         if (response.ok) {\n257:             alert('Qualification registered successfully with SHA-256 fingerprint generated!');\n258:             document.getElementById('qualificationForm').reset();\n259:             loadQualifications();\n260:         } else {\n261:             const err = await response.json();\n262:             alert('Failed to register: ' + (err.message || 'Validation error'));\n263:         }\n264:     } catch (e) {\n265:         console.error('Registration error:', e);\n266:     }\n267: }\n268: \n269: // 5. Load Audit Logs\n270: async function loadAuditLogs() {\n271:     const tableBody = document.getElementById('auditTableBody');\n272:     if (!tableBody) return;\n273: \n274:     try {\n275:         const response = await fetch('/api/v1/audit-logs');\n276:         const logs = await response.json();\n277: \n278:         tableBody.innerHTML = '';\n279:         if (logs.length === 0) {\n280:             tableBody.innerHTML = '<tr><td colspan=\"6\" style=\"text-align: center; color: #64748b;\">No verification audit logs recorded yet.</td></tr>';\n281:             return;\n282:         }\n283: \n284:         logs.forEach(log => {\n285:             const row = document.createElement('tr');\n286:             let outcomeColor = '#059669';\n287:             if (log.verificationOutcome === 'REVOKED_CREDENTIAL') outcomeColor = '#dc2626';\n288:             else if (log.verificationOutcome === 'SUSPICIOUS_OR_ALTERED') outcomeColor = '#d97706';\n289:             else if (log.verificationOutcome === 'RECORD_NOT_FOUND') outcomeColor = '#64748b';\n290: \n291:             row.innerHTML = `\n292:                 <td><strong>#${log.id}</strong></td>\n293:                 <td>${new Date(log.timestamp).toLocaleString()}</td>\n294:                 <td><code>${log.queryParameter}</code></td>\n295:                 <td><span style=\"color: ${outcomeColor}; font-weight: 700;\">${log.verificationOutcome}</span></td>\n296:                 <td>${log.verifierIdentifier}<br><small style=\"color: #64748b;\">IP: ${log.ipAddress}</small></td>\n297:                 <td><small>${log.details || 'N/A'}</small></td>\n298:             `;\n299:             tableBody.appendChild(row);\n300:         });\n301:     } catch (e) {\n302:         console.error('Error loading audit logs:', e);\n303:     }\n304: }\n305: \n306: // Auto-run on page load\n307: document.addEventListener('DOMContentLoaded', () => {\n308:     // Check URL parameters for direct verification queries\n309:     const urlParams = new URLSearchParams(window.location.search);\n310:     const certQuery = urlParams.get('cert');\n311:     if (certQuery) {\n312:         verifyCredential(certQuery);\n313:     }\n314: \n315:     // Check login state for nav\n316:     const user = getStoredUser();\n317:     const navAuthContainer = document.getElementById('navAuthStatus');\n318:     if (navAuthContainer && user) {\n319:         navAuthContainer.innerHTML = `\n320:             <span style=\"color: #cbd5e1; font-size: 0.9rem;\">Logged in as: <strong>${user.username}</strong> (${user.role})</span>\n321:             <button class=\"chip-btn revoked\" onclick=\"logout()\">Logout</button>\n322:         `;\n323:     }\n324: });\n325: \nThe above content shows the entire, complete file contents of the requested file.\n"}
