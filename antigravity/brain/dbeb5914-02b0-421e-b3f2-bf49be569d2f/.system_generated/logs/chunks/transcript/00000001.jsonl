itutionCode.trim().toUpperCase(),\n32:                 awardDate.toString(),\n33:                 salt);\n34: \n35:         return sha256(payload);\n36:     }\n37: \n38:     /**\n39:      * Verifies if given qualification parameters match an expected digital fingerprint.\n40:      */\n41:     public boolean verifyFingerprint(String certificateNumber,\n42:                                      String studentFullName,\n43:                                      String studentIdNumber,\n44:                                      String awardTitle,\n45:                                      String institutionCode,\n46:                                      LocalDate awardDate,\n47:                                      String expectedFingerprint) {\n48:         String computed = generateFingerprint(certificateNumber, studentFullName, studentIdNumber, awardTitle, institutionCode, awardDate);\n49:         return computed.equalsIgnoreCase(expectedFingerprint);\n50:     }\n51: \n52:     private String sha256(String base) {\n53:         try {\n54:             MessageDigest digest = MessageDigest.getInstance(\"SHA-256\");\n55:             byte[] hash = digest.digest(base.getBytes(StandardCharsets.UTF_8));\n56:             StringBuilder hexString = new StringBuilder();\n57:             for (byte b : hash) {\n58:                 String hex = Integer.toHexString(0xff & b);\n59:                 if (hex.length() == 1) {\n60:                     hexString.append('0');\n61:                 }\n62:                 hexString.append(hex);\n63:             }\n64:             return hexString.toString();\n65:         } catch (NoSuchAlgorithmException e) {\n66:             throw new RuntimeException(\"SHA-256 algorithm not available\", e);\n67:         }\n68:     }\n69: }\n70: \nThe above content shows the entire, complete file contents of the requested file.\n"}
