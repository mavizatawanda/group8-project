ById('registerSection');\n418:             if (reg) reg.scrollIntoView({ behavior: 'smooth' });\n419:         }\n420: \n421:         document.addEventListener('DOMContentLoaded', () => {\n422:             // 1. Enforce authentication on dashboard\n423:             const token = getAuthToken();\n424:             if (!token) {\n425:                 window.location.href = '/login?notice=verify_required';\n426:                 return;\n427:             }\n428: \n429:             const user = getStoredUser();\n430: \n431:             // 2. Role-based adjustments\n432:             if (user && user.role === 'ROLE_VERIFIER') {\n433:                 const btnIssue = document.getElementById('btnIssueQual');\n434:                 if (btnIssue) btnIssue.style.display = 'none';\n435: \n436:                 const regSection = document.getElementById('registerSection');\n437:                 if (regSection) regSection.style.display = 'none';\n438: \n439:                 const title = document.getElementById('dashHeaderTitle');\n440:                 if (title) title.innerText = 'Accredited Credential Verification Portal';\n441: \n442:                 const sub = document.getElementById('dashHeaderSubtitle');\n443:                 if (sub) sub.innerText = 'Verify academic credentials, inspect blockchain blocks, and evaluate AI fraud heuristics.';\n444:             }\n445: \n446:             // 3. Tab routing via URL query parameter\n447:             const params = new URLSearchParams(window.location.search);\n448:             const targetTab = params.get('tab');\n449:             const certQuery = params.get('cert');\n450: \n451:             if (targetTab === 'qualificationsTab') {\n452:                 switchTab('qualificationsTab', document.getElementById('tabBtnQuals'));\n453:             } else if (targetTab === 'blockchainTab') {\n454:                 switchTab('blockchainTab', document.getElementById('tabBtnBlockchain'));\n455:             } else if (targetTab === 'aiTab') {\n456:                 switchTab('aiTab', document.getElementById('tabBtnAi'));\n457:             } else if (targetTab === 'telemetryTab') {\n458:                 switchTab('telemetryTab', document.getElementById('tabBtnTelemetry'));\n459:             } else {\n460:                 // Default to Verification Console for authenticated users\n461:                 switchTab('verifyTab', document.getElementById('tabBtnVerify'));\n462:             }\n463: \n464:             // 4. Auto-verify if cert query parameter is present\n465:             if (certQuery) {\n466:                 const input = document.getElementById('verificationInput');\n467:                 if (input) input.value = certQuery;\n468:                 verifyCredential(certQuery);\n469:             }\n470: \n471:             // 5. Load data\n472:             loadQualifications();\n473:             fetchTelemetry();\n474:         });\n475:     </script>\n476: </body>\n477: </html>\n478: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
