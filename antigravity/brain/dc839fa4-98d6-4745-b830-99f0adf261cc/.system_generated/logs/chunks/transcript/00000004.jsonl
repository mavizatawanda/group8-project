/span>\\n                    <span class=\\\"chip-btn\\\" \n<truncated 4761 bytes>","StartLine":"445","TargetContent":"\"            // 2. Role-based adjustments\\n            if (user && user.role === 'ROLE_VERIFIER') {\\n                const btnIssue = document.getElementById('btnIssueQual');\\n                if (btnIssue) btnIssue.style.display = 'none';\\n\\n                const regSection = document.getElementById('registerSection');\\n                if (regSection) regSection.style.display = 'none';\\n\\n                const title = document.getElementById('dashHeaderTitle');\\n                if (title) title.innerText = 'Accredited Credential Verification Portal';\\n\\n                const sub = document.getElementById('dashHeaderSubtitle');\\n                if (sub) sub.innerText = 'Verify academic credentials, inspect blockchain blocks, and evaluate AI fraud heuristics.';\\n            }\\n\\n            // 3. Tab routing via URL query parameter\\n            const params = new URLSearchParams(window.location.search);\\n            const targetTab = params.get('tab');\\n            const certQuery = params.get('cert');\\n\\n            if (targetTab === 'qualificationsTab') {\\n                switchTab('qualificationsTab', document.getElementById('tabBtnQuals'));\\n            } else if (targetTab === 'blockchainTab') {\\n                switchTab('blockchainTab', document.getElementById('tabBtnBlockchain'));\\n            } else if (targetTab === 'aiTab') {\\n                switchTab('aiTab', document.getElementById('tabBtnAi'));\\n            } else if (targetTab === 'telemetryTab') {\\n                switchTab('telemetryTab', document.getElementById('tabBtnTelemetry'));\\n            } else {\\n                // Default to Verification Console for authenticated users\\n                switchTab('verifyTab', document.getElementById('tabBtnVerify'));\\n            }\\n\\n            // 4. Auto-verify if cert query parameter is present\\n       