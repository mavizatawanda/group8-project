eration(summary = \"Verify Credential (POST)\", description = \"Verify qualification authenticity via Certificate Number, Student ID, or Digital Hash\")\n31:     public ResponseEntity<VerificationResultDto> verifyPost(@Valid @RequestBody VerificationRequest request,\n32:                                                             HttpServletRequest servletRequest) {\n33:         String clientIp = getClientIp(servletRequest);\n34:         String userAgent = servletRequest.getHeader(\"User-Agent\");\n35:         return ResponseEntity.ok(verificationService.verifyQualification(request, clientIp, userAgent));\n36:     }\n37: \n38:     @GetMapping(\"/{certificateNumber}\")\n39:     @Operation(summary = \"Quick Verify (GET)\", description = \"Quick URL-based credential verification\")\n40:     public ResponseEntity<VerificationResultDto> verifyGet(@PathVariable String certificateNumber,\n41:                                                            HttpServletRequest servletRequest) {\n42:         VerificationRequest request = VerificationRequest.builder()\n43:                 .query(certificateNumber)\n44:                 .verifierName(\"Direct URL Verifier\")\n45:                 .build();\n46:         String clientIp = getClientIp(servletRequest);\n47:         String userAgent = servletRequest.getHeader(\"User-Agent\");\n48:         return ResponseEntity.ok(verificationService.verifyQualification(request, clientIp, userAgent));\n49:     }\n50: \n51:     private String getClientIp(HttpServletRequest request) {\n52:         String ip = request.getHeader(\"X-Forwarded-For\");\n53:         if (ip == null || ip.isEmpty() || \"unknown\".equalsIgnoreCase(ip)) {\n54:             ip = request.getRemoteAddr();\n55:         }\n56:         return ip;\n57:     }\n58: }\n59: \nThe above content shows the entire, complete file contents of the requested file.\n"}
