: async function handleRegisterQualification(event) {\n469:     event.preventDefault();\n470:     const token = getAuthToken();\n471:     if (!token) {\n472:         alert('Please login to register qualifications.');\n473:         window.location.href = '/login';\n474:         return;\n475:     }\n476: \n477:     const payload = {\n478:         certificateNumber: document.getElementById('certNumber').value.trim(),\n479:         studentFullName: document.getElementById('studentName').value.trim(),\n480:         studentIdNumber: document.getElementById('studentId').value.trim(),\n481:         awardTitle: document.getElementById('awardTitle').value.trim(),\n482:         majorSpecialization: document.getElementById('majorSpec').value.trim(),\n483:         classification: document.getElementById('classification').value.trim(),\n484:         awardDate: document.getElementById('awardDate').value,\n485:         institutionId: 1\n486:     };\n487: \n488:     try {\n489:         const response = await fetch('/api/v1/qualifications', {\n490:             method: 'POST',\n491:             headers: {\n492:                 'Content-Type': 'application/json',\n493:                 'Authorization': 'Bearer ' + token\n494:             },\n495:             body: JSON.stringify(payload)\n496:         });\n497: \n498:         if (response.ok) {\n499:             alert('Qualification registered and cryptographically mined on Blockchain!');\n500:             document.getElementById('qualificationForm').reset();\n501:             loadQualifications();\n502:             loadDashboardBlockchain();\n503:         } else {\n504:             const err = await response.json();\n505:             alert('Failed to register: ' + (err.message || 'Validation error'));\n506:         }\n507:     } catch (e) {\n508:         console.error('Registration error:', e);\n509:     }\n510: }\n511: \n512: // 6. Audit Trail Logs\n513: async function loadAuditLogs() {\n514:     const tableBody = document.getElementById('auditTableBody');\n515:     if (!tableBody) return;\n516: \n517:     try {\n518:         const response = await fetch('/api/v1/audit-logs');\n519:         const logs = await response.json();\n520: \n521:         tableBody.innerHTML = '';\n522:         if (logs.length === 0) {\n523:             tableBody.innerHTML = '<tr><td colspan=\"6\" style=\"text-align: center; color: #64748b;\">No verification audit logs recorded yet.</td></tr>';\n524:             return;\n525:         }\n526: \n527:         logs.forEach(log => {\n528:             const row = document.createElement('tr');\n529:             let outcomeColor = '#059669';\n530:             if (log.verificationOutcome === 'REVOKED_CREDENTIAL') outcomeColor = '#dc2626';\n531:             else if (log.verificationOutcome === 'SUSPICIOUS_OR_ALTERED') outcomeColor = '#d97706';\n532:             else if (log.verificationOutcome === 'RECORD_NOT_FOUND') outcomeColor = '#64748b';\n533: \n534:             row.innerHTML = `\n535:                 <td><strong>#${log.id}</strong></td>\n536:                 <td>${new Date(log.timestamp).toLocaleString()}</td>\n537:                 <td><code>${log.queryParameter}</code></td>\n538:                 <td><span style=\"color: ${outcomeColor}; font-weight: 700;\">${log.verificationOutcome}</span></td>\n539:                 <td>${log.verifierIdentifier}<br><small style=\"color: #64748b;\">IP: ${log.ipAddress}</small></td>\n540:                 <td><small>${log.details || 'N/A'}</small></td>\n541:             `;\n542:             tableBody.appendChild(row);\n543:         });\n544:     } catch (e) {\n545:         console.error('Error loading audit logs:', e);\n546:     }\n547: }\n548: \n549: // ============================================================================\n550: // INITIALIZATION ON PAGE LOAD\n551: // ============================================================================\n552: document.addEventListener('DOMContentLoaded', () => {\n553:     // Mobile navigation toggle\n554:     const navToggle = document.getElementById('navToggle');\n555:     const navMenu = document.getElementById('navMenu');\n556:     if (navToggle && navMenu) {\n557:         navToggle.addEventListener('click', () => {\n558:             navMenu.classList.toggle('open');\n559:         });\n560:     }\n561: \n562:     // Check direct certificate query in URL\n563:     const urlParams = new URLSearchParams(window.location.search);\n564:     const certQuery = urlParams.get('cert');\n565:     if (certQuery) {\n566:         verifyCredential(certQuery);\n567:     }\n568: \n569:     // Load blockchain block table on landing page\n570:     loadBlockchainTable();\n571: \n572:     // Fetch live system telemetry\n573:     fetchTelemetry();\n574: \n575:     // Check login state for nav\n576:     const user = getStoredUser();\n577:     const navAuthContainer = document.getElementById('navAuthStatus');\n578:     if (navAuthContainer && user) {\n579:         navAuthContainer.innerHTML = `\n580:             <span style=\"color: #cbd5e1; font-size: 0.85rem; margin-right: 0.5rem;\">User: <strong>${user.username}</strong></span>\n581:             <button class=\"chip-btn chip-danger\" onclick=\"logout()\">Logout</button>\n582:         `;\n583:     }\n584: });\n585: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
