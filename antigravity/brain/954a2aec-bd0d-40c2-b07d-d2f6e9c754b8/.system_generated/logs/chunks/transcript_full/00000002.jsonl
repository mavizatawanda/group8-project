abel style=\"display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem;\">Password</label>\n                    <input type=\"password\" id=\"password\" class=\"input-control\" placeholder=\"Enter password\" required>\n                </div>\n                <button type=\"submit\" class=\"btn-primary\" style=\"width: 100%;\">Sign In</button>\n            </form>\n\n            <div style=\"margin-top: 1.5rem; background: #f8fafc; border: 1px dashed #cbd5e1; padding: 1rem; border-radius: 8px; font-size: 0.8rem; color: #475569;\">\n                <p style=\"font-weight: 700; margin-bottom: 0.3rem;\">Pre-configured Demo Credentials:</p>\n                <div style=\"display: flex; gap: 0.5rem; margin-top: 0.5rem;\">\n                    <button type=\"button\" class=\"chip-btn\" onclick=\"document.getElementById('username').value='officer';document.getElementById('password').value='Officer@12345';\">\n                        Fill: Registrar Officer\n                    </button>\n                    <button type=\"button\" class=\"chip-btn\" onclick=\"document.getElementById('username').value='admin';document.getElementById('password').value='Admin@12345';\">\n                        Fill: System Admin\n                    </button>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <footer>\n        <p>DevOps Qualification Verification System &copy; 2026</p>\n    </footer>\n\n    <script src=\"/js/app.js\"></script>\n</body>\n</html>\n","Description":"Create login.html template","Overwrite":true,"TargetFile":"C:\\Users\\Madziva\\.gemini\\antigravity\\scratch\\qualification-verification-system\\src\\main\\resources\\templates\\login.html","toolAction":"Creating login.html","toolSummary":"Create login.html"}}]}
