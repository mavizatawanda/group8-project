per.writeValueAsString(loginRequest)))\n                .andExpect(status().isOk())\n                .andExpect(jsonPath(\"$.token\").isNotEmpty())\n                .andExpect(jsonPath(\"$.username\").value(\"admin\"))\n                .andExpect(jsonPath(\"$.role\").value(\"ROLE_ADMIN\"));\n    }\n\n    @Test\n    @DisplayName(\"Should fail authentication on invalid password\")\n    void testLoginInvalidPassword() throws Exception {\n        AuthRequest loginRequest = new AuthRequest(\"admin\", \"WrongPassword999\");\n\n        mockMvc.perform(post(\"/api/v1/auth/login\")\n                        .contentType(MediaType.APPLICATION_JSON)\n                        .content(objectMapper.writeValueAsString(loginRequest)))\n                .andExpect(status().isUnauthorized());\n    }\n\n    @Test\n    @DisplayName(\"Should successfully register a new verifier user\")\n    void testRegisterNewUser() throws Exception {\n        String uniqueUser = \"verifier_\" + System.currentTimeMillis();\n        RegisterRequest registerRequest = RegisterRequest.builder()\n                .username(uniqueUser)\n                .email(uniqueUser + \"@test.org\")\n                .password(\"Password@123\")\n                .fullName(\"Test Verifier\")\n                .role(Role.ROLE_VERIFIER)\n                .build();\n\n        mockMvc.perform(post(\"/api/v1/auth/register\")\n                        .contentType(MediaType.APPLICATION_JSON)\n                        .content(objectMapper.writeValueAsString(registerRequest)))\n                .andExpect(status().isOk())\n                .andExpect(jsonPath(\"$.token\").isNotEmpty())\n                .andExpect(jsonPath(\"$.username\").value(uniqueUser));\n    }\n}\n","Description":"Create AuthControllerIntegrationTest","Overwrite":true,"TargetFile":"C:\\Users\\Madziva\\.gemini\\antigravity\\scratch\\qualification-verification-system\\src\\test\\java\\com\\devops\\qvs\\controller\\AuthControllerIntegrationTest.java","toolAction":"Creating AuthControllerIntegrationTest","toolSummary":"Create AuthControllerIntegrationTest"}}]}
