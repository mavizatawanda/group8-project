>Inquiring Client / IP</th>\n                        <th>Details & Reason</th>\n                    </tr>\n                </thead>\n                <tbody id=\"auditTableBody\">\n                    <tr><td colspan=\"6\" style=\"text-align: center;\">Loading audit records...</td></tr>\n                </tbody>\n            </table>\n        </div>\n    </main>\n\n    <footer>\n        <p>DevOps Qualification Verification System &copy; 2026</p>\n    </footer>\n\n    <script src=\"/js/app.js\"></script>\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            loadAuditLogs();\n        });\n    </script>\n</body>\n</html>\n","Description":"Create audit.html template for audit trail view","Overwrite":true,"TargetFile":"C:\\Users\\Madziva\\.gemini\\antigravity\\scratch\\qualification-verification-system\\src\\main\\resources\\templates\\audit.html","toolAction":"Creating audit.html","toolSummary":"Create audit.html"}}]}
