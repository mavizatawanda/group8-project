).append(\"\\n\");\n236:             sb.append(\"• **Student ID**: \").append(q.getStudentIdNumber()).append(\"\\n\");\n237: \n238:             if (q.getStatus() == QualificationStatus.REVOKED && q.getRevocationReason() != null) {\n239:                 sb.append(\"• **Revocation Ruling**: ⚠️ *\").append(q.getRevocationReason()).append(\"*\\n\");\n240:             }\n241: \n242:             sb.append(\"• **AI Fraud Score**: **\").append(aiAnalysis.getAuthenticityScore())\n243:               .append(\"/100 (\").append(aiAnalysis.getRiskLevel()).append(\" RISK)**\\n\");\n244:             sb.append(\"• **AI Recommendation**: \").append(aiAnalysis.getRecommendation());\n245: \n246:             return AiChatResponse.builder()\n247:                     .reply(sb.toString())\n248:                     .intent(q.getStatus() == QualificationStatus.ACTIVE ? \"VERIFY_ACTIVE\" : \"VERIFY_REVOKED\")\n249:                     .status(q.getStatus() == QualificationStatus.ACTIVE ? \"SUCCESS\" : \"WARNING\")\n250:                     .timestamp(now)\n251:                     .build();\n252:         }\n253: \n254:         // 6. If user tried to check a non-existent certificate\n255:         if (msg.contains(\"qvs-\") || msg.contains(\"check\") || msg.contains(\"verify\")) {\n256:             return AiChatResponse.builder()\n257:                     .reply(\"⚠️ **Institutional Registry Search Outcome**:\\n\\n\"\n258:                             + \"No accredited qualification record was found matching your query in the institutional database. \"\n259:                             + \"If this certificate was presented on physical paper or PDF, there is a **high risk of unauthorized alteration or forgery**.\")\n260:                     .intent(\"NOT_FOUND\")\n261:                     .status(\"WARNING\")\n262:                     .timestamp(now)\n263:                     .build();\n264:         }\n265: \n266:         // Generic intelligent fallback\n267:         return AiChatResponse.builder()\n268:                 .reply(\"Hello! I am your **QVS Agentic AI Assistant**. You can ask me to:\\n\\n\"\n269:                         + \"• Check specific student records (e.g., *'Check Sarah Jenkins'*, *'Check David Miller'*, or *'Check Marcus Vance'*)\\n\"\n270:                         + \"• Explain the **Access Levels between Admin, Officer, and Verifier**\\n\"\n271:                         + \"• Explain how the **Blockchain Ledger** ensures zero tampering\\n\"\n272:                         + \"• Inspect **AI Fraud Risk** rules and anomaly scoring\")\n273:                 .intent(\"GENERAL_ASSIST\")\n274:                 .status(\"INFO\")\n275:                 .timestamp(now)\n276:                 .build();\n277:     }\n278: \n279:     private List<Qualification> findMatchingQualifications(String query) {\n280:         if (query == null || query.isBlank()) {\n281:             return List.of();\n282:         }\n283:         try {\n284:             // First check direct certificate number format\n285:             for (String part : query.split(\"[^a-zA-Z0-9-]\")) {\n286:                 if (part.toUpperCase().startsWith(\"QVS-\")) {\n287:                     Optional<Qualification> byCert = qualificationRepository.findByCertificateNumber(part.toUpperCase());\n288:                     if (byCert.isPresent()) {\n289:                         return List.of(byCert.get());\n290:                     }\n291:                 }\n292:             }\n293: \n294:             // Next check search query\n295:             String cleanQuery = query.replaceAll(\"(?i)\\\\b(check|verify|inspect|who is|what is|tell me about|certificate|student)\\\\b\", \"\").trim();\n296:             if (!cleanQuery.isBlank()) {\n297:                 List<Qualification> results = qualificationRepository.searchQualifications(cleanQuery);\n298:                 if (results != null && !results.isEmpty()) {\n299:                     return results;\n300:                 }\n301:             }\n302:         } catch (Exception e) {\n303:             log.warn(\"Error during AI chat qualification lookup: {}\", e.getMessage());\n304:         }\n305:         return List.of();\n306:     }\n307: }\n308: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
