{"step_index":342,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-12T19:44:52Z","content":"Created At: 2026-09-12T21:44:52+02:00\nCompleted At: 2026-09-12T21:44:52+02:00\nFile Path: `file:///C:/Users/Madziva/.gemini/antigravity/scratch/qualification-verification-system/src/test/java/com/devops/qvs/service/AiFraudDetectionServiceTest.java`\nTotal Lines: 142\nTotal Bytes: 5771\nShowing lines 1 to 142\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: package com.devops.qvs.service;\n2: \n3: import com.devops.qvs.dto.AiAnalysisResultDto;\n4: import com.devops.qvs.dto.AiChatRequest;\n5: import com.devops.qvs.dto.AiChatResponse;\n6: import com.devops.qvs.model.Institution;\n7: import com.devops.qvs.model.Qualification;\n8: import com.devops.qvs.model.QualificationStatus;\n9: import com.devops.qvs.repository.QualificationRepository;\n10: import org.junit.jupiter.api.BeforeEach;\n11: import org.junit.jupiter.api.DisplayName;\n12: import org.junit.jupiter.api.Test;\n13: import org.junit.jupiter.api.extension.ExtendWith;\n14: import org.mockito.InjectMocks;\n15: import org.mockito.Mock;\n16: import org.mockito.junit.jupiter.MockitoExtension;\n17: \n18: import java.time.LocalDate;\n19: import java.util.Optional;\n20: \n21: import static org.junit.jupiter.api.Assertions.assertEquals;\n22: import static org.junit.jupiter.api.Assertions.assertNotNull;\n23: import static org.junit.jupiter.api.Assertions.assertTrue;\n24: import static org.mockito.ArgumentMatchers.any;\n25: import static org.mockito.ArgumentMatchers.anyString;\n26: import static org.mockito.Mockito.when;\n27: \n28: @ExtendWith(MockitoExtension.class)\n29: @DisplayName(\"Unit Tests: Agentic AI Fraud Detection & Assistant Service\")\n30: class AiFraudDetectionServiceTest {\n31: \n32:     @Mock\n33:     private QualificationRepository qualificationRepository;\n34: \n35:     @Mock\n36:     private CryptoHashService cryptoHashService;\n37: \n38:     @InjectMocks\n39:     private AiFraudDetectionService aiFraudDetectionService;\n40: \n41:     private Institution sampleInstitution;\n42:     private Qualification genuineQual;\n43:     private Qualification revokedQual;\n44: \n45:     @BeforeEach\n46:     void setUp() {\n47:         sampleInstitution = Institution.builder()\n48:                 .id(1L)\n49:                 .name(\"National Institute of Tech\")\n50:                 .institutionCode(\"NIT-001\")\n51:                 .active(true)\n52:                 .build();\n53: \n54:         genuineQual = Qualification.builder()\n55:                 .id(101L)\n56:                 .certificateNumber(\"QVS-2024-BSC-8891\")\n57:                 .studentFullName(\"Sarah Jenkins\")\n58:                 .studentIdNumber(\"STU-990142\")\n59:                 .awardTitle(\"Bachelor of Science in Software Engineering\")\n60:                 .majorSpecialization(\"DevOps\")\n61:                 .classification(\"First Class Honours\")\n62:                 .awardDate(LocalDate.of(2024, 7, 15))\n63:                 .institution(sampleInstitution)\n64:                 .status(QualificationStatus.ACTIVE)\n65:                 .digitalFingerprint(\"valid_hash_12345\")\n66:                 .build();\n67: \n68:         revokedQual = Qualification.builder()\n69:                 .id(102L)\n70:                 .certificateNumber(\"QVS-2022-DIP-1109\")\n71:                 .studentFullName(\"Marcus Vance\")\n72:                 .studentIdNumber(\"STU-772911\")\n73:                 .awardTitle(\"Diploma in Enterprise Systems\")\n74:                 .majorSpecialization(\"Infrastructure\")\n75:                 .classification(\"Second Class\")\n76:                 .awardDate(LocalDate.of(2022, 6, 30))\n77:                 .institution(sampleInstitution)\n78:                 .status(QualificationStatus.REVOKED)\n79:                 .revocationReason(\"Disciplinary misconduct\")\n80:                 .digitalFingerprint(\"revoked_hash_99999\")\n81:                 .build();\n82:     }\n83: \n84:     @Test\n85:     @DisplayName(\"Should assign LOW risk and 100 authenticity score for genuine valid certificate\")\n86:     void testAnalyzeGenuineCertificate() {\n87:         when(qualificationRepository.findByCertificateNumber(\"QVS-2024-BSC-8891\"))\n88:                 .thenReturn(Optional.of(genuineQual));\n89:         when(cryptoHashService.verifyFingerprint(anyString(), anyString(), anyString(), anyString(), anyString(), any(LocalDate.class), anyString()))\n90:                 .thenReturn(true);\n91: \n92:         AiAnalysisResultDto result = aiFraudDetectionService.analyzeCertificate(\"QVS-2024-BSC-8891\");\n93: \n94:         assertNotNull(result);\n95:         assertEquals(\"LOW\", result.getRiskLevel());\n96:         assertEquals(100, result.getAuthenticityScore());\n97:         assertTrue(result.getPassedChecks().size() >= 3);\n98:         assertTrue(result.getAnomalyFlags().isEmpty());\n99:     }\n100: \n101:     @Test\n102:     @DisplayName(\"Should assign HIGH/CRITICAL risk when certificate is revoked\")\n103:     void testAnalyzeRevokedCertificate() {\n104:         when(qualificationRepository.findByCertificateNumber(\"QVS-2022-DIP-1109\"))\n105:                 .thenReturn(Optional.of(revokedQual));\n106:         when(cryptoHashService.verifyFingerprint(anyString(), anyString(), anyString(), anyString(), anyString(), any(LocalDate.class), anyString()))\n107:                 .thenReturn(true);\n108: \n109:         AiAnalysisResultDto result = aiFraudDetectionService.analyzeCertificate(\"QVS-2022-DIP-1109\");\n110: \n111:         assertNotNull(result);\n112:         assertTrue(result.getRiskLevel().equals(\"HIGH\") || result.getRiskLevel().equals(\"CRITICAL\"));\n113:         assertTrue(result.getAuthenticityScore() < 50);\n114:         assertTrue(result.getAnomalyFlags().stream().anyMatch(f -> f.contains(\"REVOKED\")));\n115:     }\n116: \n117:     @Test\n118:     @DisplayName(\"Should assign CRITICAL risk and 0 score when certificate does not exist in registry\")\n119:     void testAnalyzeNonExistentCertificate() {\n120:         when(qualificationRepository.findByCertificateNumber(\"FAKE-999\"))\n121:                 .thenReturn(Optional.empty());\n122: \n123:         AiAnalysisResultDto result = aiFraudDetectionService.analyzeCertificate(\"FAKE-999\");\n124: \n125:         assertNotNull(result);\n126:         assertEquals(\"CRITICAL\", result.getRiskLevel());\n127:         assertEquals(0, result.getAuthenticityScore());\n128:     }\n129: \n130:     @Test\n131:     @DisplayName(\"Should respond intelligently to AI conversational user queries\")\n132:     void testChatWithAgent() {\n133:         AiChatResponse response = aiFraudDetectionService.processUserQuery(\n134:                 AiChatRequest.builder().message(\"How do I verify a certificate?\").build()\n135:         );\n136: \n137:         assertNotNull(response);\n138:         assertEquals(\"INFO\", response.getStatus());\n139:         assertTrue(response.getReply().contains(\"How to Verify\"));\n140:     }\n141: }\n142: \nThe above content shows the entire, complete file contents of the requested file.\n"}
