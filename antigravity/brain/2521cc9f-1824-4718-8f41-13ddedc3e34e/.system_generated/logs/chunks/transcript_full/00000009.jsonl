{"step_index":457,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-14T04:14:41Z","content":"Created At: 2026-09-14T06:14:41+02:00\nCompleted At: 2026-09-14T06:14:41+02:00\nFile Path: `file:///C:/Users/Madziva/.gemini/antigravity/scratch/qualification-verification-system/src/main/resources/static/js/app.js`\nTotal Lines: 649\nTotal Bytes: 26202\nShowing lines 1 to 75\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * DevOps Qualification Verification System (QVS 2.0)\n3:  * Frontend Interactive Client with Blockchain, AI Agent & Real-Time Telemetry\n4:  */\n5: \n6: // Helper to get stored auth token\n7: function getAuthToken() {\n8:     return localStorage.getItem('qvs_token');\n9: }\n10: \n11: function getStoredUser() {\n12:     const user = localStorage.getItem('qvs_user');\n13:     return user ? JSON.parse(user) : null;\n14: }\n15: \n16: function saveAuthSession(authResponse) {\n17:     localStorage.setItem('qvs_token', authResponse.token);\n18:     localStorage.setItem('qvs_user', JSON.stringify(authResponse));\n19: }\n20: \n21: function logout() {\n22:     localStorage.removeItem('qvs_token');\n23:     localStorage.removeItem('qvs_user');\n24:     window.location.href = '/login';\n25: }\n26: \n27: // ============================================================================\n28: // 1. PUBLIC VERIFICATION & BLOCKCHAIN / AI PROOF LOOKUP\n29: // ============================================================================\n30: async function verifyCredential(queryOverride) {\n31:     const queryInput = document.getElementById('verificationInput');\n32:     const query = queryOverride || (queryInput ? queryInput.value.trim() : '');\n33: \n34:     if (!query) {\n35:         alert('Please enter a certificate number, student ID, or digital fingerprint hash.');\n36:         return;\n37:     }\n38: \n39:     if (queryInput) queryInput.value = query;\n40: \n41:     const resultCard = document.getElementById('resultCard');\n42:     const loadingSpinner = document.getElementById('loadingIndicator');\n43: \n44:     if (loadingSpinner) loadingSpinner.style.display = 'block';\n45:     if (resultCard) resultCard.style.display = 'none';\n46: \n47:     try {\n48:         const token = getAuthToken();\n49:         const user = getStoredUser();\n50:         const headers = { 'Content-Type': 'application/json' };\n51:         if (token) {\n52:             headers['Authorization'] = 'Bearer ' + token;\n53:         }\n54: \n55:         const verifierName = user ? (user.fullName || user.username) : 'Authorized Officer';\n56:         const verifierOrg = user ? (user.institutionName || (user.role ? user.role.replace('ROLE_', '') : 'Authorized Entity')) : 'Authorized Verifier';\n57: \n58:         const response = await fetch('/api/v1/verify', {\n59:             method: 'POST',\n60:             headers: headers,\n61:             body: JSON.stringify({\n62:                 query: query,\n63:                 verifierName: verifierName,\n64:                 verifierOrganization: verifierOrg\n65:             })\n66:         });\n67: \n68:         const data = await response.json();\n69:         displayVerificationResult(data);\n70: \n71:         // Also fetch AI analysis for this certificate\n72:         if (data.certificateNumber) {\n73:             fetchAiAnalysis(data.certificateNumber);\n74:         }\n75:     } catch (error) {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
