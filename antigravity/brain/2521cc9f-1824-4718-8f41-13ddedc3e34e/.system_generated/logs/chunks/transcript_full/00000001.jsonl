\n68: \n69:             // 2. Seed Users\n70:             userRepository.save(User.builder()\n71:                     .username(\"admin\")\n72:                     .email(\"admin@qvs.internal\")\n73:                     .password(passwordEncoder.encode(\"Admin@12345\"))\n74:                     .fullName(\"DevOps System Administrator\")\n75:                     .role(Role.ROLE_ADMIN)\n76:                     .enabled(true)\n77:                     .build());\n78: \n79:             userRepository.save(User.builder()\n80:                     .username(\"officer\")\n81:                     .email(\"officer@nit.edu\")\n82:                     .password(passwordEncoder.encode(\"Officer@12345\"))\n83:                     .fullName(\"Academic Registrar Officer\")\n84:                     .role(Role.ROLE_INSTITUTION)\n85:                     .institution(inst1)\n86:                     .enabled(true)\n87:                     .build());\n88: \n89:             userRepository.save(User.builder()\n90:                     .username(\"verifier\")\n91:                     .email(\"verifier@trusted-partner.org\")\n92:                     .password(passwordEncoder.encode(\"Verifier@12345\"))\n93:                     .fullName(\"Accredited Verification Agent\")\n94:                     .role(Role.ROLE_VERIFIER)\n95:                     .enabled(true)\n96:                     .build());\n97: \n98:             // 3. Seed Qualifications and Notarize on Blockchain\n99:             createSeedQualification(\n100:                     \"QVS-2024-BSC-8891\",\n101:                     \"Sarah Jenkins\",\n102:                     \"STU-990142\",\n103:                     \"Bachelor of Science in Software Engineering\",\n104:                     \"DevOps & Cloud Computing\",\n105:                     \"First Class Honours\",\n106:                     LocalDate.of(2024, 7, 15),\n107:                     inst1,\n108:                     QualificationStatus.ACTIVE,\n109:                     null\n110:             );\n111: \n112:             createSeedQualification(\n113:                     \"QVS-2023-MSC-4412\",\n114:                     \"David Miller\",\n115:                     \"STU-881230\",\n116:                     \"Master of Science in Cybersecurity\",\n117:                     \"Information Security & Cryptography\",\n118:                     \"Distinction\",\n119:                     LocalDate.of(2023, 11, 20),\n120:                     inst1,\n121:                     QualificationStatus.ACTIVE,\n122:                     null\n123:             );\n124: \n125:             createSeedQualification(\n126:                     \"QVS-2022-DIP-1109\",\n127:                     \"Marcus Vance\",\n128:                     \"STU-772911\",\n129:                     \"Diploma in Enterprise Systems Administration\",\n130:                     \"Infrastructure Management\",\n131:                     \"Upper Second Class\",\n132:                     LocalDate.of(2022, 6, 30),\n133:                     inst2,\n134:                     QualificationStatus.REVOKED,\n135:                     \"Issued in error - Academic misconduct disciplinary ruling\"\n136:             );\n137: \n138:             logger.info(\"Sample qualification data & blockchain ledger successfully initialized.\");\n139:         }\n140:     }\n141: \n142:     private void createSeedQualification(String certNum, String studentName, String studentId,\n143:                                          String awardTitle, String specialization, String classification,\n144:                                          LocalDate awardDate, Institution institution, QualificationStatus status,\n145:                                          String revocationReason) {\n146:         String fingerprint = cryptoHashService.generateFingerprint(\n147:                 certNum, studentName, studentId, awardTitle, institution.getInstitutionCode(), awardDate\n148:         );\n149: \n150:         Qualification q = Qualification.builder()\n151:                 .certificateNumber(certNum)\n152:                 .studentFullName(studentName)\n153:                 .studentIdNumber(studentId)\n154:                 .awardTitle(awardTitle)\n155:                 .majorSpecialization(specialization)\n156:                 .classification(classification)\n157:                 .awardDate(awardDate)\n158:                 .institution(institution)\n159:                 .status(status)\n160:                 .digitalFingerprint(fingerprint)\n161:                 .revocationReason(revocationReason)\n162:                 .build();\n163: \n164:         Qualification saved = qualificationRepository.save(q);\n165: \n166:         try {\n167:             blockchainLedgerService.mineBlock(\n168:                     saved.getCertificateNumber(),\n169:                     saved.getDigitalFingerprint(),\n170:                     saved.getStatus() == QualificationStatus.REVOKED ? \"REVOKE\" : \"ISSUE\",\n171:                     institution.getName()\n172:             );\n173:         } catch (Exception e) {\n174:             logger.warn(\"Seeding blockchain block error: {}\", e.getMessage());\n175:         }\n176:     }\n177: }\n178: \nThe above content shows the entire, complete file contents of the requested file.\n"}
