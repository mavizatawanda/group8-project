; border-radius: 12px; font-size: 0.85rem; margin-bottom: 1.25rem; text-align: left; line-height: 1.45;\">\n                <div style=\"display: flex; align-items: center; gap: 0.6rem;\">\n                    <span style=\"font-size: 1.1rem;\">⚠️</span>\n                    <span id=\"loginErrorText\">Invalid credentials. Please verify your username and password.</span>\n                </div>\n            </div>\n\n            <!-- Login Form -->\n            <form onsubmit=\"handleLogin(event)\">\n                <!-- Username Field -->\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"username\">\n                        <span>Username</span>\n                    </label>\n                    <div class=\"input-wrapper\">\n                        <span class=\"input-icon-left\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path>\n                                <circle cx=\"12\" cy=\"7\" r=\"4\"></circle>\n                            </svg>\n                        </span>\n                        <input type=\"text\" id=\"username\" class=\"input-control has-icon-left\" placeholder=\"Enter username (e.g. admin, officer_zou)\" required autofocus autocomplete=\"username\">\n                    </div>\n                </div>\n\n                <!-- Password Field -->\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"password\">\n                        <span>Password</span>\n                    </label>\n                    <div class=\"input-wrapper\">\n                        <span class=\"input-icon-left\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-