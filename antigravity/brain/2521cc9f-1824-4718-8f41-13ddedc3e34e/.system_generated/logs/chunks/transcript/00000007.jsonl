86:                 .certificateNumber(certNum)\n587:                 .studentFullName(studentName)\n588:                 .studentIdNumber(studentId)\n589:                 .awardTitle(awardTitle)\n590:                 .majorSpecialization(specialization)\n591:                 .classification(classification)\n592:                 .awardDate(awardDate)\n593:                 .institution(institution)\n594:                 .status(status)\n595:                 .digitalFingerprint(fingerprint)\n596:                 .revocationReason(revocationReason)\n597:                 .build();\n598: \n599:         Qualification saved = qualificationRepository.save(q);\n600: \n601:         try {\n602:             blockchainLedgerService.mineBlock(\n603:                     saved.getCertificateNumber(),\n604:                     saved.getDigitalFingerprint(),\n605:                     saved.getStatus() == QualificationStatus.REVOKED ? \"REVOKE\" : \"ISSUE\",\n606:                     institution.getName()\n607:             );\n608:         } catch (Exception e) {\n609:             logger.warn(\"Seeding blockchain block error: {}\", e.getMessage());\n610:         }\n611:     }\n612: }\n613: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
