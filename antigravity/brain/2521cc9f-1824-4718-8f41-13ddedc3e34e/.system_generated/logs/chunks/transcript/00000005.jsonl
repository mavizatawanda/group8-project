ory qualificationRepository;\n34: \n35:     @Mock\n36:     private CryptoHashService cryptoHashService;\n37: \n38:     @InjectMocks\n39:     private AiFraudDetectionService aiFraud\n<truncated 2908 bytes>\nate is revoked\")\n103:     void testAnalyzeRevokedCertificate() {\n104:         when(qualificationRepository.findByCertificateNumber(\"QVS-2022-DIP-1109\"))\n105:                 .thenReturn(Optional.of(revokedQual));\n106:         when(cryptoHashService.verifyFingerprint(anyString(), anyString(), anyString(), anyString(), anyString(), any(LocalDate.class), anyString()))\n107:                 .thenReturn(true);\n108: \n109:         AiAnalysisResultDto result = aiFraudDetectionService.analyzeCertificate(\"QVS-2022-DIP-1109\");\n110: \n111:         assertNotNull(result);\n112:         assertTrue(result.getRiskLevel().equals(\"HIGH\") || result.getRiskLevel().equals(\"CRITICAL\"));\n113:         assertTrue(result.getAuthenticityScore() < 50);\n114:         assertTrue(result.getAnomalyFlags().stream().anyMatch(f -> f.contains(\"REVOKED\")));\n115:     }\n116: \n117:     @Test\n118:     @DisplayName(\"Should assign CRITICAL risk and 0 score when certificate does not exist in registry\")\n119:     void testAnalyzeNonExistentCertificate() {\n120:         when(qualificationRepository.findByCertificateNumber(\"FAKE-999\"))\n121:                 .thenReturn(Optional.empty());\n122: \n123:         AiAnalysisResultDto result = aiFraudDetectionService.analyzeCertificate(\"FAKE-999\");\n124: \n125:         assertNotNull(result);\n126:         assertEquals(\"CRITICAL\", result.getRiskLevel());\n127:         assertEquals(0, result.getAuthenticityScore());\n128:     }\n129: \n130:     @Test\n131:     @DisplayName(\"Should respond intelligently to AI conversational user queries\")\n132:     void testChatWithAgent() {\n133:         AiChatResponse response = aiFraudDetectionService.processUserQuery(\n134:                 AiChatRequest.builder().message(\"How do I verify a certificat